# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
# NUNCA versione .env.local nem cole segredos reais aqui.

# URL do projeto Supabase (Project Settings > Data API).
NEXT_PUBLIC_SUPABASE_URL=

# Chave publica do Supabase (publishable key / anon key).
# Pode ir para o navegador: quem protege os dados e o RLS, nao esta chave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Use apenas no servidor e somente se uma operacao administrativa realmente exigir.
# Ignora TODAS as politicas de RLS. Nunca prefixe com NEXT_PUBLIC_,
# nunca importe em Client Component e nunca devolva em resposta HTTP.
# O fluxo normal do sistema nao precisa desta chave.
SUPABASE_SERVICE_ROLE_KEY=

# URL publica da aplicacao; usada nos links de e-mail do Supabase Auth.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fuso de exibicao. A persistencia continua em timestamptz (UTC).
APP_TIMEZONE=America/Recife
